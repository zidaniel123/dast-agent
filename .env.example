# --- LLM gateway / API access ------------------------------------------------
# API key for your OpenAI-compatible gateway or the OpenAI API.
OPENAI_API_KEY=

# Base URL of your OpenAI-compatible gateway. Leave blank to use the default
# OpenAI endpoint.
OPENAI_API_BASE=

# Model id to drive both agents. Replaceable with any model your gateway
# exposes over the OpenAI-compatible API. Defaults to the built-in gateway id
# when unset.
DAST_MODEL=openai-responses/gpt-5.6-luna

# --- Optional tuning ---------------------------------------------------------
# Max agent turns per phase (default 50).
# DAST_MAX_TURNS=50

# Playwright MCP session timeout in seconds (default 600).
# DAST_MCP_TIMEOUT=600
