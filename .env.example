# --- LLM gateway / API access ------------------------------------------------
# API key for your OpenAI-compatible gateway or the OpenAI API.
OPENAI_API_KEY=

# Base URL of your OpenAI-compatible gateway.
# Leave blank (or omit) to use the default OpenAI endpoint.
OPENAI_API_BASE=

# Model id to drive both agents. Set this to a model your gateway actually
# exposes — the built-in fallback is a plain OpenAI id and is unlikely to be
# right for a gateway. Override per run with --model.
DAST_MODEL=gpt-4o

# --- Optional tuning ---------------------------------------------------------
# Max agent turns per phase (default 50). Raise this if the walk phase stops
# before it has covered your application.
# DAST_MAX_TURNS=50

# Playwright MCP session timeout in seconds (default 600).
# DAST_MCP_TIMEOUT=600

# --- Browser hardening (all opt-in; each one weakens the browser) ------------
# Disable the Chromium sandbox. The sandbox is the main boundary between a
# hostile page and your host — only set this if your container requires it.
# DAST_BROWSER_NO_SANDBOX=1

# Accept invalid TLS certificates. Convenient against staging with a self-signed
# cert, but the scan then cannot detect TLS misconfiguration and the session is
# open to interception.
# DAST_IGNORE_HTTPS_ERRORS=1

# Route browser traffic through an intercepting proxy (ZAP, Burp, mitmproxy).
# Recommended: it gives you a real, capturable record of every request the agent
# sent, instead of relying on the model to transcribe evidence accurately.
# DAST_PROXY_SERVER=http://127.0.0.1:8080
